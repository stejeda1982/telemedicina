// Prisma schema for servicio-mensajeria
// Database: mensajeria_db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MENSAJERIA")
}

model Conversacion {
  conversacion_id String   @id @default(uuid())
  paciente_id     String
  profesional_id  String
  cita_id         String?
  tipo            String   @default("paciente_profesional")
  created_at      DateTime @default(now())
  mensajes        Mensaje[]
}

model Mensaje {
  id               BigInt   @id @default(autoincrement())
  conversacion_id  String
  remitente_id     String
  texto            String
  leido            Boolean  @default(false)
  created_at       DateTime @default(now())
  conversacion     Conversacion @relation(fields: [conversacion_id], references: [conversacion_id])
  @@index([conversacion_id])
}

model Interconsulta {
  id               BigInt   @id @default(autoincrement())
  conversacion_id  String
  especialidad     String
  motivo           String
  estado           String   @default("solicitada")
  created_at       DateTime @default(now())
}

// Outbox pattern: events written in the same DB transaction as business changes.
// Drained by @telemed/common OutboxService every 2s.
model OutboxEvent {
  id           BigInt   @id @default(autoincrement())
  event_type   String
  payload      Json
  status       String   @default("PENDING")
  attempts     Int      @default(0)
  created_at   DateTime @default(now())
  published_at DateTime?
  @@index([status, created_at])
}
