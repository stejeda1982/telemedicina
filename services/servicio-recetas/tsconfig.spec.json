{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "types": [
      "jest",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@telemed/common": [
        "./test/mocks/common.ts"
      ],
      "@telemed/contracts": [
        "./test/mocks/contracts.ts"
      ]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
