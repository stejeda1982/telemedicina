# ============================================================
# .env.dev — Variables de entorno para desarrollo local
#
# Copiar a .env:  cp .env.dev .env
# Usar con docker-compose.dev.yml o con pnpm start:dev
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=telemed
POSTGRES_PASSWORD=telemed
# Local (docker-compose):
DATABASE_URL_IDENTIDAD=postgresql://telemed:telemed@localhost:5432/telemed_identidad
DATABASE_URL_PACIENTES=postgresql://telemed:telemed@localhost:5432/telemed_pacientes
DATABASE_URL_PROFESIONALES=postgresql://telemed:telemed@localhost:5432/telemed_profesionales
DATABASE_URL_AGENDA=postgresql://telemed:telemed@localhost:5432/telemed_agenda
DATABASE_URL_VIDEO=postgresql://telemed:telemed@localhost:5432/telemed_video
DATABASE_URL_EXPEDIENTE=postgresql://telemed:telemed@localhost:5432/telemed_expediente
DATABASE_URL_RECETAS=postgresql://telemed:telemed@localhost:5432/telemed_recetas
DATABASE_URL_PAGOS=postgresql://telemed:telemed@localhost:5432/telemed_pagos
DATABASE_URL_MENSAJERIA=postgresql://telemed:telemed@localhost:5432/telemed_mensajeria
DATABASE_URL_NOTIFICACIONES=postgresql://telemed:telemed@localhost:5432/telemed_notificaciones
DATABASE_URL_INTEGRACIONES=postgresql://telemed:telemed@localhost:5432/telemed_integraciones
DATABASE_URL_AUDITORIA=postgresql://telemed:telemed@localhost:5432/telemed_auditoria

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222
NATS_MONITORING_URL=http://localhost:8222

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- WSO2 Identity Server (JWT validation) ---
# Para dev local: usar el JWKS endpoint del WSO2 IS desplegado
# Si no hay WSO2 IS disponible, los endpoints /health siguen siendo públicos
WSO2_IS_JWKS_URI=https://localhost:9443/oauth2/jwks
WSO2_IS_ISSUER=https://localhost:9443/oauth2/token
WSO2_IS_CLIENT_ID=telemed_dev_client
WSO2_IS_CLIENT_SECRET=dev_secret_placeholder

# --- Stripe (pagos) ---
# Claves de test (no son reales, usar las de tu cuenta de Stripe test)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- MercadoPago (pagos) ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR_placeholder
MERCADOPAGO_WEBHOOK_SECRET=webhook_placeholder

# --- Twilio (SMS/notificaciones) ---
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+15000000000

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=placeholder
WHATSAPP_PHONE_NUMBER_ID=placeholder

# --- SAT CFDI (facturación) ---
SAT_CFDI_WS_ENDPOINT=https://pruebascfdi.sat.gob.mx
SAT_CFDI_USER=placeholder
SAT_CFDI_PASSWORD=placeholder

# --- FHIR (integraciones) ---
FHIR_BASE_URL=http://hapi.fhir.org/baseR4

# --- Puertos de los servicios ---
PORT_IDENTIDAD=3001
PORT_PACIENTES=3002
PORT_PROFESIONALES=3003
PORT_AGENDA=3004
PORT_VIDEO=3005
PORT_EXPEDIENTE=3006
PORT_RECETAS=3007
PORT_PAGOS=3008
PORT_MENSAJERIA=3009
PORT_NOTIFICACIONES=3010
PORT_INTEGRACIONES=3011
PORT_AUDITORIA=3012

# --- BFFs ---
PORT_BFF_PACIENTE=4001
PORT_BFF_PROFESIONAL=4002
PORT_BFF_ADMIN=4003

# --- Multi-tenancy ---
DEFAULT_TENANT_ID=default

# --- Logging ---
LOG_LEVEL=debug
