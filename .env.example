# ============================================================
# Telemedicina Monorepo - Environment Variables
# Copy to .env and fill in real values for local development
# ============================================================

# --- Database (one PostgreSQL instance, one DB per service for dev) ---
DATABASE_URL_IDENTIDAD=postgresql://telemed:telemed@localhost:5432/identidad_db
DATABASE_URL_PACIENTES=postgresql://telemed:telemed@localhost:5432/pacientes_db
DATABASE_URL_PROFESIONALES=postgresql://telemed:telemed@localhost:5432/profesionales_db
DATABASE_URL_AGENDA=postgresql://telemed:telemed@localhost:5432/agenda_db
DATABASE_URL_VIDEO=postgresql://telemed:telemed@localhost:5432/video_db
DATABASE_URL_EXPEDIENTE=postgresql://telemed:telemed@localhost:5432/expediente_db
DATABASE_URL_RECETAS=postgresql://telemed:telemed@localhost:5432/recetas_db
DATABASE_URL_PAGOS=postgresql://telemed:telemed@localhost:5432/pagos_db
DATABASE_URL_MENSAJERIA=postgresql://telemed:telemed@localhost:5432/mensajeria_db
DATABASE_URL_NOTIFICACIONES=postgresql://telemed:telemed@localhost:5432/notificaciones_db
DATABASE_URL_INTEGRACIONES=postgresql://telemed:telemed@localhost:5432/integraciones_db
DATABASE_URL_AUDITORIA=postgresql://telemed:telemed@localhost:5432/auditoria_db

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- WSO2 Identity Server ---
WSO2_IS_BASE_URL=https://localhost:9443
WSO2_IS_OAUTH_ISSUER=https://localhost:9443/oauth2/token
WSO2_IS_JWKS_URI=https://localhost:9443/oauth2/jwks
WSO2_IS_CLIENT_ID=telemedicina_bff
WSO2_IS_CLIENT_SECRET=CHANGE_ME

# --- External connectors (managed by WSO2 MI) ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
MERCADOPAGO_ACCESS_TOKEN=CHANGE_ME
PAC_SAT_ENDPOINT=https://demo-facturacion.clickfacturacion.com
PAC_SAT_TOKEN=CHANGE_ME
WHATSAPP_CLOUD_TOKEN=CHANGE_ME
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
FCM_SERVER_KEY=CHANGE_ME

# --- App ---
NODE_ENV=development
LOG_LEVEL=debug
