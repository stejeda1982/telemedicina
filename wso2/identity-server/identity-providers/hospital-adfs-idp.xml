<?xml version="1.0" encoding="UTF-8"?>
<!-- Identity Provider federado: hospital con ADFS (SAML 2.0) -->
<IdentityProvider>
  <IdentityProviderName>hospital-adfs</IdentityProviderName>
  <DisplayName>Hospital Central ADFS</DisplayName>
  <IdentityProviderDescription>Federación SAML 2.0 con ADFS del hospital cliente</IdentityProviderDescription>
  <FederatedAuthenticatorConfigs>
    <FederatedAuthenticatorConfig>
      <Name>SAMLSSOAuthenticator</Name>
      <DisplayName>SAML2 Web SSO</DisplayName>
      <Properties>
        <Property><Name>IdpEntityId</Name><Value>https://adfs.hospital.com.mx/federationmetadata/2007-06/FederationMetadata.xml</Value></Property>
        <Property><Name>SSOUrl</Name><Value>https://adfs.hospital.com.mx/adfs/ls/</Value></Property>
        <Property><Name>signingCertificate</Name><Value>REPLACE_WITH_HOSPITAL_CERT_BASE64</Value></Property>
        <Property><Name>NameIDPolicyFormat</Name><Value>urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified</Value></Property>
      </Properties>
    </FederatedAuthenticatorConfig>
  </FederatedAuthenticatorConfigs>
  <JustInTimeProvisioningConfig>
    <ProvisioningEnabled>true</ProvisioningEnabled>
    <ProvisioningUserStore>TELEMED</ProvisioningUserStore>
    <ProvisioningClaims>
      <Claim><ClaimUri>http://wso2.org/claims/username</ClaimUri><ClaimMapping>subject</ClaimMapping></Claim>
    </ProvisioningClaims>
  </JustInTimeProvisioningConfig>
</IdentityProvider>
