<?xml version="1.0" encoding="UTF-8"?>
<!-- WhatsApp Cloud API connector template for outbound calls from WSO2 MI -->
<template xmlns="http://ws.apache.org/ns/synapse" name="whatsapp-cloud-connector">
  <parameter name="method"/>
  <parameter name="path"/>
  <parameter name="payload"/>
  <sequence>
    <call>
      <endpoint>
        <http uri-template="https://graph.facebook.com/v18.0{$ctx:path}" method="{$ctx:method}"/>
      </endpoint>
    </call>
    <!-- Auth header injected from secret -->
    <property name="Authorization" value="Bearer ${WA_CLOUD_TOKEN}" scope="transport"/>
  </sequence>
</template>
