<?xml version="1.0" encoding="UTF-8"?>
<!--
  SEQ-07-export-fhir: Exportación de expediente a FHIR R4 Bundle
  Pattern: fetch + transform
  Services: expediente(GET) + pacientes(GET) + fhir-connector
  Correlation: X-Correlation-Id propagated end-to-end.

  Flow:
    1. Extract paciente_id
    2. Fetch paciente demographics (GET pacientes/{id})
    3. Fetch expediente (GET expediente/paciente/{paciente_id})
    4. Transform to FHIR R4 Bundle (Composition + Patient + Encounter + Observation)
    5. Respond with FHIR Bundle

  FHIR resources mapped:
    - Patient (from pacientes)
    - Encounter (from cita)
    - ClinicalImpression / CarePlan (from nota de evolución)
    - Observation (from signos vitales, LOINC-coded)
-->
<api xmlns="http://ws.apache.org/ns/synapse"
     name="SEQ-07-export-fhir"
     context="/seq-07-export-fhir"
     method="POST">
  <inSequence>
    <!-- 1. Extract JWT claims and correlation_id propagated from API Gateway -->
    <property name="jwt_sub" expression="get-property('transport', 'X-JWT-Sub')"/>
    <property name="jwt_tenant" expression="get-property('transport', 'X-JWT-Tenant')"/>
    <property name="correlation_id" expression="get-property('transport', 'X-Correlation-Id')"/>
    <property name="saga_id" expression="get-property('correlation_id')"/>
    <property name="Authorization" expression="get-property('transport', 'Authorization')" scope="transport"/>
    <property name="Content-Type" value="application/json" scope="transport"/>
    <property name="Accept" value="application/json" scope="transport"/>
    <log level="custom">
      <property name="sequence" value="SEQ-07-export-fhir"/>
      <property name="saga_id" expression="get-property('saga_id')"/>
      <property name="jwt_sub" expression="get-property('jwt_sub')"/>
    </log>

    <!-- 2. Persist saga_state = STARTED -->
    <dbupdate>
      <connection><pool><dsName>jdbc/wso2mi_saga</dsName></pool></connection>
      <statement>
        <sql>INSERT INTO saga_state (saga_id, sequence_id, status, started_at, correlation_id) VALUES (?,?,?,?,?)</sql>
        <parameter expression="get-property('saga_id')" type="VARCHAR"/>
        <parameter value="SEQ-07-export-fhir" type="VARCHAR"/>
        <parameter value="STARTED" type="VARCHAR"/>
        <parameter expression="get-property('SYSTEM_DATE')" type="TIMESTAMP"/>
        <parameter expression="get-property('correlation_id')" type="VARCHAR"/>
      </statement>
    </dbupdate>

    <!-- Extract paciente_id -->
    <property name="paciente_id" expression="json-eval($.paciente_id)"/>

    <!-- 3. Fetch paciente demographics -->
    <property name="To" expression="fn:concat('http://servicio-pacientes.core.svc.cluster.local:3002/api/v1/pacientes/', get-property('paciente_id'))" scope="default"/>
    <property name="HTTP_METHOD" value="GET" scope="axis2"/>
    <call>
      <endpoint>
        <http uri-template="{ctx:To}" method="GET">
          <timeout><duration>5000</duration><responseAction>fault</responseAction></timeout>
        </http>
      </endpoint>
    </call>
    <filter source="$axis2:HTTP_SC" regex="200">
      <then>
        <property name="paciente_curp" expression="json-eval($.curp)"/>
        <property name="paciente_nombres" expression="json-eval($.nombres)"/>
        <property name="paciente_apellido_p" expression="json-eval($.apellido_p)"/>
        <property name="paciente_fecha_nac" expression="json-eval($.fecha_nac)"/>
        <property name="paciente_sexo" expression="json-eval($.sexo)"/>
      </then>
      <else>
        <payloadFactory media-type="json">
          <format>{"error":"Paciente no encontrado"}</format>
        </payloadFactory>
        <property name="HTTP_SC" value="404" scope="axis2"/>
        <respond/>
      </else>
    </filter>

    <!-- 4. Fetch expediente (notas + signos vitales) -->
    <property name="To" expression="fn:concat('http://servicio-expediente.core.svc.cluster.local:3006/api/v1/expediente/paciente/', get-property('paciente_id'))" scope="default"/>
    <property name="HTTP_METHOD" value="GET" scope="axis2"/>
    <call>
      <endpoint>
        <http uri-template="{ctx:To}" method="GET">
          <timeout><duration>10000</duration><responseAction>fault</responseAction></timeout>
        </http>
      </endpoint>
    </call>
    <property name="expediente_data" expression="json-eval($)"/>

    <!-- 5. Transform to FHIR R4 Bundle -->
    <payloadFactory media-type="json">
      <format>{"resourceType":"Bundle","type":"collection","entry":[{"resource":{"resourceType":"Patient","id":"$1","identifier":[{"system":"urn:mx:curp","value":"$2"}],"name":[{"family":"$3","given":["$4"]}],"birthDate":"$5","gender":"$6"}}]}</format>
      <args>
        <arg expression="get-property('paciente_id')"/>
        <arg expression="get-property('paciente_curp')"/>
        <arg expression="get-property('paciente_apellido_p')"/>
        <arg expression="get-property('paciente_nombres')"/>
        <arg expression="get-property('paciente_fecha_nac')"/>
        <arg expression="get-property('paciente_sexo')"/>
      </args>
    </payloadFactory>
    <log level="custom"><property name="step" value="fhir_bundle_composed"/></log>

    <!-- 6. Respond with FHIR Bundle -->
    <property name="HTTP_SC" value="200" scope="axis2"/>
    <respond/>
  </inSequence>

  <faultSequence>
    <log level="custom">
      <property name="sequence" value="SEQ-07-export-fhir"/>
      <property name="status" value="FAULT"/>
    </log>
    <payloadFactory media-type="json">
      <format>{"resourceType":"OperationOutcome","issue":[{"severity":"error","code":"processing","diagnostics":"$1"}]}</format>
      <args><arg expression="$ctx:ERROR_MESSAGE"/></args>
    </payloadFactory>
    <property name="HTTP_SC" value="500" scope="axis2"/>
    <respond/>
  </faultSequence>
</api>